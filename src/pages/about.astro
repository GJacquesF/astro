---
import Header from '../components/Header.astro';
import '../styles/global.css';
import Footer from '../components/Footer.astro';

const pageTitle = "Sobre mi";

const identity = {
  firstName: "Gibrel",
  country: "GDL",
  occupation: "Tecnologo en desarrollo de software",
  hobbies: ["entrenar", "cocinar", "putno de cruz"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Redacción de documentos"];

const happy = true;
const finished = true;
const goal = 1;

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Astro</title>
        <title>{pageTitle}</title>

        <style define:vars={{skillColor, fontWeight, textCase}}>
        h1 {
            color: purple;
            font-size: 4rem;
        }
        .skill {
            color: var(--skillColor);
            font-weight: var(--fontWeight);
            text-transform: var(--textCase);
        }
        </style>
    </head>
    <body>
        <Header />

        <h1>Mi sitio Astro</h1>
        <h1>{pageTitle}</h1>

        <p>He aquí algunos datos sobre mí:</p>
        <ul>
        <li>Me llamo {identity.firstName}.</li>
        <li>Vivo en {identity.country} y trabajo como {identity.occupation}.</li>
        {identity.hobbies.length >= 2 &&
            <li>Dos de mis aficiones son: {identity.hobbies[0]} y {identity.hobbies[1]}</li>
        }
        </ul>
        <p>Mis habilidades son:</p>
        <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
        </ul>

        {happy && <p>¡Estoy feliz de aprender Astro!</p>}

        {finished && <p>¡He terminado este tutorial!</p>}

        {goal === 1 ? <p>Mi objetivo es terminar en 1 día.</p> : <p>Mi objetivo no es 1 día.</p>}

        <p>Estoy chambeando en mi curso de Astro voy en el módulo 2.</p>
        <p>Esta pagina se actualiza automáticamente cuando hago cambios.</p>
        <Footer />
        <script>
        import "../scripts/menu.js";
        </script>
    </body>
</html>